{
  "name": "shugoi/shugoi-php",
  "description": "Shugoi anti-abuse protection — PHP/Laravel middleware",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.0",
    "psr/http-server-middleware": "^1.0",
    "psr/http-message": "^2.0"
  },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0",
        "nyholm/psr7": "^1.8",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "nyholm/psr7": "Required for Laravel integration (PSR-7 to Laravel bridge)"
    },
    "config": {
        "allow-plugins": false
    },
    "minimum-stability": "stable",
  "autoload": {
    "psr-4": { "Shugoi\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Shugoi\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": [ "Shugoi\\Laravel\\ShugoiServiceProvider" ],
      "aliases": { "Shugoi": "Shugoi\\Laravel\\ShugoiFacade" }
    }
  }
}
